<%/*
  引用串攤平成一維的列（見 present.ts 的 flattenThread）。

  縮排不再是巢狀 <ul> 疊出來的 border-left，而是每一列自己畫的軌道；
  伺服器已經把上游排成反序，所以這裡不分方向，照著印就好。
*/%>
<ul class="thread">
<% it.rows.forEach(function (n) { %>
  <li class="node<%= n.visible ? '' : ' off' %>" data-key="<%= n.key %>" data-anc="<%= n.ancestors.join(' ') %>">
    <span class="rails" aria-hidden="true"
      ><% n.rails.forEach(function (r) { %><span class="rail rail-<%= r %>"></span><% }) %><%
        if (n.branch) { %><span class="rail rail-<%= n.branch %>"></span><% } %></span>
    <%/* U13 每列：色點 + rel + 型別：標題 + 日期時刻。
         關係詞在標題前面，方向編在詞裡（節錄自／節錄出）。 */%>
    <%/* 七種關係各有一個圖示。**永遠與關係詞並列**，不單獨出現——
         一個還沒學過的圖示自己站著就是一個謎題，兩個一起才錨得住。
         圖示不隨上下游翻轉（維持 7 種外觀）：方向已經由軌道的位置
         與關係詞本身（節錄自／節錄出）講過兩次了。 */%>
    <% if (n.missing) { %>
    <span class="nodebody">
      <%~ include('icon', { name: n.rel }) %>
      <span class="noderel"><%= n.relLabel %></span>
      <span class="nodemissing">找不到 <%= n.id %></span>
    </span>
    <% } else { %>
    <span class="nodebody">
      <span class="dot dot-<%= n.type %>"></span>
      <%~ include('icon', { name: n.rel }) %>
      <span class="noderel"><%= n.relLabel %></span>
      <%/* 標記排在標題前面，順序是「已被更新」、環境名、標題（v3.3 §5）。
           標題會被截斷，排在後面的東西會跟著被擠掉；排在前面就一定看得到。 */%>
      <%/* v3.3 §3：那張卡已被更新或反駁。只標記，點進去頂端的提示連得到新卡。 */%>
      <% n.marks.forEach(function (m) { %><span class="supmark"><%= m %></span><% }) %>
      <%/* 連結可以跨環境（v3.1）：另一頭在別的環境就標出環境名。 */%>
      <% if (n.env) { %><span class="envmark"><%= n.env %></span><% } %>
      <%/* 型別名在連結外面：窄螢幕上標題自己換到第二行，型別名留在第一行（v3.3 §5.4）。
           寬螢幕上的「：」由 CSS 補，窄螢幕上它是一枚獨立的標籤，不帶冒號。 */%>
      <span class="tname"><%= n.typeLabel %></span>
      <a class="nodetitle" href="/c/<%= n.id %>"><%= n.title %></a>
      <%/* 同一張卡會從不同分支被走到，只有第一次完整展開。 */%>
      <% if (n.repeated) { %><span class="noderel">上方已展開</span><% } %>
      <% if (n.children) { %>
      <button type="button" class="textbtn nodetoggle" data-toggle="<%= n.key %>"
        aria-expanded="<%= n.expanded ? 'true' : 'false' %>"><%= n.children %></button>
      <% } %>
      <time datetime="<%= n.date.iso %>" data-rel><%= n.date.text %></time>
      <span class="nodetime clock num"></span>
    </span>
    <% } %>
  </li>
<% }) %>
</ul>
