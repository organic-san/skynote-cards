<p class="back"><a class="textbtn" href="/c/<%= it.card.id %>">← 回卡片</a></p>

<ul class="errors" id="errors" hidden></ul>

<%/* 這一頁的欄位一律是伺服器從卡片填進來的，所以草稿不靜默覆蓋。
     清除也跟建立頁不同：送出走 fetch PUT，沒有導向可以掛 ?d=，
     由 editform.js 在請求成功之後自己清（見 js/draft.js）。 */%>
<%/* data-rev：載入時這張卡的內容。送出時帶回去，伺服器發現別處改過就回 409，
     舊的這一頁不會無聲蓋掉另一頁存下的修改（見 js/editform.js）。 */%>
<%/* data-home：刪除之後回到這張卡所在環境的首頁（v3.1）。 */%>
<form class="newform" id="editcard" data-id="<%= it.card.id %>" data-rev="<%= it.rev %>"
      data-home="<%= it.base %>/"
      data-draft-scope="<%= it.draftScope %>" data-draft-prefilled>
  <p class="cardmeta">
    <span class="rtype rtype-<%= it.card.type %>"><%= it.type_label %></span>
    <time datetime="<%= it.created_display.iso %>"><%= it.created_display.text %></time>
    <%/* 倒數只出現在這一頁。卡片頁是拿來讀的，一個每秒跳一次的數字
         放在內文上方是干擾；在這裡你就是在跟那段時間賽跑。
         沒有期限的（產出，R15）沒有賽跑，只說一次規則。 */%>
    <%/* 倒數跟複製、下載綁成一段推到行末：分開推的話兩段會把空位對分，
         窄螢幕上折行時按鈕也會落到左邊，跟卡片頁不一致。 */%>
    <span class="metaend">
    <% if (it.no_window) { %>
    <span class="lock">被引用之前都可以修改</span>
    <% } else { %>
    <span class="lock num" id="lock" data-until="<%= it.lock_at %>"></span>
    <% } %>
    <%/* v3.3 §1：複製與下載，跟卡片頁同一個位置、同一組按鈕。
         交出去的是文字框當下的內容，包含還沒存的修改——存檔的版本在卡片頁上有。
         data-for 指向那個文字框；標題在按下去的當下從表單的標題欄讀（js/download.js）。 */%>
    <% const field = it.single ? 'singletext' : 'bodytext'; %>
    <span class="cardtools">
      <button type="button" class="toolbtn copybtn" id="copybtn" aria-label="複製內文" data-for="<%= field %>">
        <%~ include('icon', { name: 'copy' }) %><%~ include('icon', { name: 'check' }) %><span class="copysaid">已複製</span>
      </button>
      <button type="button" class="toolbtn dlbtn" id="dlbtn" aria-label="下載成 .md 檔"
              data-for="<%= field %>" data-file="<%= it.card.id %>.md">
        <%~ include('icon', { name: 'download' }) %>
      </button>
    </span>
    </span>
  </p>

  <% if (it.single) { %>
  <%/* 碎片只有一個大文字框，跟建立表單一致（見 new.eta 的 #singlefield）。
       那段話存在 title 裡，但照欄位印進單行的標題欄，換行會被瀏覽器丟掉，
       一存檔就壓成一行。欄位名也沿用 quick_body，反轉由伺服器做。 */%>
  <%/* 工具列不能放進 <label>（見 mdbar.eta），所以文字框的外層是 div。 */%>
  <div class="field">
    <%~ include('mdbar', { for: 'singletext' }) %>
    <textarea name="quick_body" id="singletext" rows="10" spellcheck="false" required data-mdbar><%= it.single_text %></textarea>
  </div>
  <% } else { %>
  <%/* 標題與內文照表單上的樣子印（formFields）：沒有標題的資料，標題欄空著，
       那段文字回到內文欄。資料的標題選填、內文必填（R16）——這裡補上標題，它就變回有標題的資料。 */%>
  <label class="field">
    <span>標題</span>
    <input type="text" name="title" autocomplete="off" value="<%= it.fields.title %>"
           <%~ it.optional_title ? 'placeholder="可以不填"' : 'required' %>>
  </label>

  <div class="field">
    <label for="bodytext">內文</label>
    <%~ include('mdbar', { for: 'bodytext' }) %>
    <textarea name="body" id="bodytext" rows="14" spellcheck="false"<%= it.optional_title ? ' required' : '' %> data-mdbar><%= it.fields.body %></textarea>
  </div>
  <% } %>

  <%/* 標籤用空白分隔（不是逗號），推薦面板見 js/tags.js。 */%>
  <label class="field" id="tagsfield" data-tags='<%= JSON.stringify(it.tags_all) %>'>
    <span>標籤</span>
    <input type="text" name="tags" autocomplete="off" placeholder="用空白分隔"
           value="<%= it.tags_line %>">
    <div class="picker tagpicker"></div>
  </label>

  <%/* R7：反芻期內連結只增不減。既有連結為唯讀清單，僅允許新增；
       R8：碎片不得有連結。 */%>
  <% if (it.can_link) { %>
  <div class="field" id="linksfield"
       data-rels='<%= JSON.stringify(it.rel_table) %>'
       data-default-rels='<%= JSON.stringify(it.default_rels) %>'
       data-env="<%= it.env %>"
       data-card-type="<%= it.card.type %>">
    <span class="fieldhead">連結
      <button type="button" class="ghost addlink" id="addlink">＋</button>
    </span>
    <% if (it.links.length) { %>
    <ul class="linklist">
      <% it.links.forEach(function (l) { %>
      <li>
        <span class="noderel"><%= l.label %></span>
        <a href="/c/<%= l.to %>"><%= l.title || l.to %></a>
      </li>
      <% }) %>
    </ul>
    <% } %>
    <div id="linkrows"></div>
    <p class="fieldnote">已經建立的連結不能刪除或修改。</p>
  </div>
  <% } %>

  <details class="optional">
    <summary>網址</summary>
    <label class="field">
      <span>網址</span>
      <input type="url" name="url" autocomplete="off" value="<%= it.card.url || '' %>">
    </label>
  </details>

  <%/* 動作列：儲存靠左，破壞性操作（刪除）置於右端以避免誤觸。 */%>
  <div class="stepnav">
    <button type="submit" class="primary">儲存</button>
    <a class="ghost" href="/c/<%= it.card.id %>">取消</a>
    <button type="button" class="destructive" id="deletecard" data-id="<%= it.card.id %>">
      刪除
    </button>
  </div>
</form>

<%/* 連結列跟建立頁共用同一支——收窄關係、搜尋目標、加一列，
     那是同一件事，不該有兩份會慢慢長歪的實作。 */%>
<script src="<%= it.asset('/static/js/links.js') %>" defer></script>
<script src="<%= it.asset('/static/js/tags.js') %>" defer></script>
<script src="<%= it.asset('/static/js/editform.js') %>" defer></script>
<script src="<%= it.asset('/static/js/mdbar.js') %>" defer></script>
<script src="<%= it.asset('/static/js/copy.js') %>" defer></script>
<script src="<%= it.asset('/static/js/download.js') %>" defer></script>

<%/* 新增的那幾列長什麼樣。跟建立頁同一份結構，選項由 links.js 畫。 */%>
<template id="linkrowtpl">
  <%/* data-blank：這是使用者手動加的空白列，rel 從 DEFAULT_REL 起頭
       （見 present.ts 與 links.js）。伺服器印出來的那幾列沒有這個記號，
       它們的關係是入口決定的，已經有明確的意圖。 */%>
  <div class="linkrow" data-blank>
    <select name="link_rel"></select>
    <input type="text" class="linkto" autocomplete="off" placeholder="輸入標題搜尋"
           data-target-type="">
    <input type="hidden" name="link_to" value="">
    <button type="button" class="ghost rmlink" aria-label="移除這一列">−</button>
    <div class="picker"></div>
  </div>
</template>
