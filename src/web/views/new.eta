<div class="<%= it.source ? 'split' : '' %>" id="split">

<% if (it.source) { %>
<section class="pane pane-source" id="sourcepane">
  <div class="sourcebody">
    <p class="cardmeta">
      <span class="dot dot-<%= it.source.type %>"></span>
      <span class="tname"><%= it.source.typeLabel %></span>
      <span class="sep">·</span>
      <time datetime="<%= it.source.date.iso %>" data-rel><%= it.source.date.text %></time>
      <% if (it.source.provenance) { %><span class="sep">·</span><span><%= it.source.provenance %></span><% } %>
      <a class="sourceopen" href="/c/<%= it.source.id %>">開啟</a>
    </p>
    <% if (it.source.heading) { %>
    <h1 class="<%= it.source.heading.long ? 'long' : '' %>"><%= it.source.heading.text %></h1>
    <% } %>
    <% if (it.source.tags.length) { %>
    <p class="tags">
      <% it.source.tags.forEach(function (t) { %><span class="tag">#<%= t %></span><% }) %>
    </p>
    <% } %>
    <div class="body" id="sourcetext" data-id="<%= it.source.id %>" data-title="<%= it.source.title %>"><%~ it.source.body_html %></div>
  </div>
  <%/* 引用鈕黏在來源面板的下緣：它是讀到哪就想引哪的動作，
       跟著文章捲到末段就等於在你需要它的時候不在。 */%>
  <div class="quotebar">
    <button type="button" class="ghost" id="quotebtn" disabled>＋ 引用選取的段落</button>
  </div>
</section>
<div class="splitbar" id="splitbar" role="separator" aria-label="調整比例"></div>
<% } %>

<section class="<%= it.source ? 'pane pane-form' : '' %>">

<% if (it.action === '展開成思考') { %>
<p class="back"><a class="textbtn" href="/">← 返回</a></p>
<% } %>

<% if (it.errors.length) { %>
<ul class="errors">
  <% it.errors.forEach(function (e) { %><li><%= e %></li><% }) %>
</ul>
<% } %>

<h1 class="formtitle"><%= it.action %></h1>

<form method="post" action="/new" class="newform" id="newform"
      data-specs='<%= JSON.stringify(it.specs) %>'>
  <input type="hidden" name="reply_to" value="<%= it.replyTo %>">

  <% if (it.locked) { %>
  <%/* 型別是入口決定的，所以這裡只陳述事實，不給選擇。

       兩種入口都適用：卡片頁的 ＋ 選單同時預填了型別與連結，改型別會讓
       預填的關係不合法；追加外部資料與隨手記的展開沒有連結，但它們的型別
       同樣只有一個正確答案——換一個就得填這張表單拿不到的欄位。 */%>
  <p class="typefixed">
    <span class="dot dot-<%= it.values.type %>"></span>
    <span class="tname"><%= it.typeLabel %></span>
  </p>
  <input type="hidden" name="type" value="<%= it.values.type %>">
  <% } else { %>
  <div class="typepick">
    <% it.types.forEach(function (t) { %>
    <label class="typebtn">
      <input type="radio" name="type" value="<%= t.value %>" required <%= it.values.type === t.value ? 'checked' : '' %>>
      <span><%= t.label %></span>
    </label>
    <% }) %>
  </div>
  <% } %>

  <%/* 碎片只有一個大文字框，不區分標題與內文。那段話會存進 title，
       但介面上不呈現這個區分（見 domain/card.ts 的 fleetingText）。 */%>
  <label class="field<%= it.spec.single ? '' : ' off' %>" id="singlefield">
    <textarea name="quick_body" rows="10" spellcheck="false" placeholder="寫下那句話" data-grow
              <%= it.spec.single ? 'required' : 'disabled' %>><%= it.spec.single ? it.values.title : '' %></textarea>
  </label>

  <label class="field<%= it.spec.single ? ' off' : '' %>" id="titlefield">
    <span>標題</span>
    <input type="text" name="title" autocomplete="off" value="<%= it.spec.single ? '' : it.values.title %>"
           <%= it.spec.single ? 'disabled' : 'required' %>>
  </label>

  <%/* url 對 original 是主要欄位，不藏在收合區裡。 */%>
  <label class="field<%= it.spec.url ? '' : ' off' %>" id="urlfield">
    <span>網址</span>
    <input type="url" name="url" autocomplete="off" value="<%= it.values.url %>"
           placeholder="選填">
  </label>

  <label class="field<%= it.spec.single ? ' off' : '' %>" id="bodyfield">
    <span>內文</span>
    <textarea name="body" rows="14" spellcheck="false" data-grow><%= it.values.body %></textarea>
  </label>

  <div class="field secondary<%= it.spec.source ? '' : ' off' %>" id="sourcefields">
    <div class="fieldpair">
      <label><span>作者</span>
        <input type="text" name="source_author" autocomplete="off" value="<%= it.values.source_author %>">
      </label>
      <label><span>原始年份</span>
        <input type="text" name="source_date" autocomplete="off" value="<%= it.values.source_date %>"
               placeholder="原始發布日期">
      </label>
    </div>
  </div>

  <details class="optional<%= it.spec.source ? '' : ' off' %>" id="provfield">
    <summary>來源標記</summary>
    <label class="field">
      <span>provenance</span>
      <select name="provenance" <%= it.spec.source ? '' : 'disabled' %>>
        <% it.provenances.forEach(function (p) { %>
        <option value="<%= p %>" <%= it.values.provenance === p ? 'selected' : '' %>><%= p %></option>
        <% }) %>
      </select>
    </label>
  </details>

  <p class="fieldnote<%= it.spec.links ? ' off' : '' %>" id="linkshint">選好類型才知道可以建立哪些關係。</p>

  <%/* data-card-type 由 typefields.js 改寫，links.js 看著它重畫關係選項。
       兩支檔案因此不互相呼叫，也不必知道對方存在。 */%>
  <div class="field<%= it.spec.links ? '' : ' off' %>" id="linksfield"
       data-rels='<%= JSON.stringify(it.relTable) %>'
       data-card-type="<%= it.values.type %>">
    <span class="fieldhead">連結
      <button type="button" class="ghost addlink" id="addlink">＋</button>
    </span>
    <div id="linkrows">
      <% it.links.forEach(function (l, i) { %>
      <% const opts = it.rowRels[i] || it.rels; %>
      <%/* U15：目標一律顯示標題，ID 不外露。整套設計的目的就是使用者
           永遠不必碰 ID——把 18 位數當欄位主值是主次相反。
           U16：從卡片 `+` 預填的那條是唯讀列，只有 rel 可改，沒有減號。 */%>
      <div class="linkrow<%= l.fixed ? ' fixed' : '' %>">
        <select name="link_rel">
          <% opts.forEach(function (r) { %>
          <option value="<%= r.value %>" <%= l.rel === r.value ? 'selected' : '' %>><%= r.label %></option>
          <% }) %>
        </select>
        <% if (l.fixed) { %>
        <%/* 標題自成一格，所以截斷交給 CSS；完整的字留在 title 屬性裡。 */%>
        <span class="linktarget" title="<%= l.title || l.to %>"><%= l.title || l.to %></span>
        <input type="hidden" name="link_to" value="<%= l.to %>">
        <% } else { %>
        <%/* 看得到的是標題，送出去的是 ID（U15）。
             直接貼 ID 也還能用：打字時會鏡射到底下那個 hidden。 */%>
        <input type="text" class="linkto" autocomplete="off"
               placeholder="輸入標題搜尋" value="<%= l.title || l.to %>"
               data-target-type="<%= l.targetType || '' %>">
        <input type="hidden" name="link_to" value="<%= l.to %>">
        <button type="button" class="ghost rmlink" aria-label="移除這一列">−</button>
        <div class="picker"></div>
        <% } %>
      </div>
      <% }) %>
    </div>
  </div>

  <%/* 標籤用空白分隔（不是逗號），推薦面板見 js/tags.js。 */%>
  <label class="field<%= it.spec.single ? ' off' : '' %>" id="tagsfield"
         data-tags='<%= JSON.stringify(it.tags_all) %>'>
    <span>標籤</span>
    <input type="text" name="tags" autocomplete="off" placeholder="用空白分隔"
           value="<%= it.values.tags %>">
    <div class="picker tagpicker"></div>
  </label>

  <%/* 跟編輯頁同一條規矩：每次都要按的那顆在最便宜的位置。 */%>
  <div class="stepnav">
    <button type="submit" class="primary">送出</button>
  </div>
</form>

</section>
</div>

<%/* 選項留空：links.js 一定會重畫（型別與目標都會改變可選的關係），
     伺服器先畫一份只是讓同一件事有兩個來源。 */%>
<template id="linkrowtpl">
  <div class="linkrow">
    <select name="link_rel"></select>
    <input type="text" class="linkto" autocomplete="off" placeholder="輸入標題搜尋"
           data-target-type="">
    <input type="hidden" name="link_to" value="">
    <button type="button" class="ghost rmlink" aria-label="移除這一列">−</button>
    <div class="picker"></div>
  </div>
</template>

<%/* 依職責分檔，跟 css/ 一樣。每一支只做一件事，名字就說了是哪一件：
     欄位長高、連結列、依型別開關欄位、來源面板（拖曳與引用）。
     連結列跟編輯頁共用同一支。 */%>
<script src="/static/js/grow.js" defer></script>
<script src="/static/js/links.js" defer></script>
<script src="/static/js/tags.js" defer></script>
<script src="/static/js/typefields.js" defer></script>
<script src="/static/js/sourcepane.js" defer></script>
