<div class="filters">
  <a href="/" class="textbtn <%= !it.type ? 'on' : '' %>">全部</a>
  <%/* U7：篩選列各項前方也放同一顆色點——這是使用者學會色彩對應的唯一場所。 */%>
  <% it.types.forEach(function (t) { %>
  <a href="/?type=<%= t.value %><%= it.tagQuery %>" class="textbtn <%= it.type === t.value ? 'on' : '' %>">
    <span class="dot dot-<%= t.value %>"></span><%= t.label %></a>
  <% }) %>
  <% if (it.tag) { %><span class="filtertag">#<%= it.tag %></span><% } %>
  <span class="filtercount"><%= it.total %></span>
</div>

<%~ include('cardlist', { items: it.items, empty: '沒有卡片。' }) %>

<%/* 分頁列：僅在多頁時顯示，前後翻頁按鈕依當前頁碼顯示。 */%>
<% if (it.pages > 1) { %>
<nav class="pager">
  <%/* 箭頭以 aria-label 標示方向。 */%>
  <% if (it.page > 1) { %>
  <a class="textbtn" href="<%= it.baseQuery %>page=1">最新</a>
  <a class="textbtn" href="<%= it.baseQuery %>page=<%= it.page - 1 %>" aria-label="上一頁">←</a>
  <% } %>
  <span class="pagenow num"><%= it.page %> / <%= it.pages %></span>
  <% if (it.page < it.pages) { %>
  <a class="textbtn" href="<%= it.baseQuery %>page=<%= it.page + 1 %>" aria-label="下一頁">→</a>
  <a class="textbtn" href="<%= it.baseQuery %>page=<%= it.pages %>">最早</a>
  <% } %>
</nav>
<% } %>
