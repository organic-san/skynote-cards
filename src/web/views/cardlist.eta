<% if (it.items.length === 0) { %>
<p class="empty"><%= it.empty %></p>
<% } else { %>
<ul class="rows">
<% it.items.forEach(function (c) { %>
  <li class="row row-<%= c.type %>">
    <%/* 碎片不是一張卡，是一行字：它的標題就是全部內容，
         所以不套標題樣式，也不需要底下那條後設資料。 */%>
    <% if (c.type === 'fleeting') { %>
    <p class="rowline"><a href="/c/<%= c.id %>"><%= c.title %></a></p>
    <p class="rowmeta">
      <span class="rtype rtype-fleeting"><%= c.typeLabel %></span>
      <time><%= c.date %></time>
    </p>
    <% } else { %>
    <% if (c.eyebrow) { %><p class="roweyebrow"><%= c.eyebrow %></p><% } %>
    <h2 class="rowtitle"><a href="/c/<%= c.id %>"><%= c.title %></a></h2>
    <% if (c.excerpt) { %><p class="rowtext"><%= c.excerpt %></p><% } %>
    <% if (c.meta) { %><p class="rowabout"><%= c.meta %></p><% } %>
    <p class="rowmeta">
      <span class="rtype rtype-<%= c.type %>"><%= c.typeLabel %></span>
      <% if (c.counts) { %><span class="rowcounts"><%= c.counts %></span><% } %>
      <% c.tags.forEach(function (t) { %><a class="tag" href="/?tag=<%= encodeURIComponent(t) %>">#<%= t %></a><% }) %>
      <time><%= c.date %></time>
    </p>
    <% } %>
  </li>
<% }) %>
</ul>
<% } %>
