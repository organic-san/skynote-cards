<% if (it.items.length === 0) { %>
<p class="empty"><%= it.empty %></p>
<% } else { %>
<ul class="rows">
<% it.items.forEach(function (c) { %>
  <%/* 色點直接服務於標題，所以它就在標題正前方；日期與時刻跟在標題之後。
       原本把色點與日期關在一個 72px 的左欄裡（U3），那讓標題離頁面左緣很遠，
       而色點要標示的正是標題那一行。項目之間不用分隔線，改用間距（U2）。 */%>
  <li class="row<%= c.heading ? '' : ' untitled' %>">
    <span class="dot dot-<%= c.type %>"></span>
    <div class="rowmain">
      <%/* 碎片沒有標題，這一行就只剩日期——那也正是它的識別方式：
           一則隨手記靠「什麼時候寫的」認，不靠名字。 */%>
      <p class="rowhead">
        <%/* 標記排在標題前面：「已被更新」、環境名、標題（v3.3 §5）。
             搜尋結果與「已隱藏」那一頁才會有「已被更新」；環境名只在搜尋「所有環境」時有。

             有標題時，標記跟標題包在同一段文字裡（.rowheading）：標題接在標記後面，
             排不下就逐字換到下一行，不是整個標題跳到下一行（v3.3 §5.4）。
             碎片沒有標題，標記就排在日期前面。 */%>
        <% if (c.heading) { %>
        <span class="rowheading"><% c.marks.forEach(function (m) { %><span class="supmark"><%= m %></span><% }) %><% if (c.env) { %><span class="envmark"><%= c.env %></span><% } %><a class="rowtitle" href="/c/<%= c.id %>"><%= c.heading.text %></a></span>
        <% } else { %>
        <% c.marks.forEach(function (m) { %><span class="supmark"><%= m %></span><% }) %>
        <% if (c.env) { %><span class="envmark"><%= c.env %></span><% } %>
        <% } %>
        <%/* datetime 是 UTC 真值，內容是保底文字；app.js 依瀏覽器時區改寫（U4）。
             時刻由腳本填，沒有 JS 時那一格是空的，不佔位。 */%>
        <time datetime="<%= c.date.iso %>" data-rel><%= c.date.text %></time>
        <span class="rowtime clock num"></span>
      </p>
      <%/* 搜尋結果用命中的那一段取代內文開頭：那一頁要回答的是
           「這張卡為什麼被找出來」。frag 已經在伺服器轉義過並包好 <mark>
           （見 present.ts 的 highlight），所以用 `<%~` 印。 */%>
      <% if (c.frag) { %>
        <% if (c.heading) { %>
        <p class="rowtext"><%~ c.frag %></p>
        <% } else { %>
        <a class="rowtext rowbody" href="/c/<%= c.id %>"><%~ c.frag %></a>
        <% } %>
      <% } else if (c.excerpt) { %>
        <%/* excerpt 保留換行（v3.2 §1），由 .rowlines 的 pre-line 排出來。
             所以標籤與 excerpt 之間不能有空白或換行——會被當成內文排出來。 */%>
        <% if (c.heading) { %>
        <p class="rowtext rowlines"><%= c.excerpt %></p>
        <% } else { %>
        <%/* 沒有標題時，內文自己就是那條連結——否則這一列點不進去。 */%>
        <a class="rowtext rowbody rowlines" href="/c/<%= c.id %>"><%= c.excerpt %></a>
        <% } %>
      <% } %>
      <p class="rowmeta">
        <%/* U5：型別名固定在第一段，其餘以 · 分隔。 */%>
        <span class="tname"><%= c.typeLabel %></span>
        <% c.meta.forEach(function (m) { %><span class="sep">·</span><span><%= m %></span><% }) %>
        <%/* 別的環境的卡（搜尋「所有環境」時）的環境名移到標題前面了（v3.3 §5）。 */%>
        <%/* 標籤以環境為界，點下去回到這張卡所在的環境（v3.1）。 */%>
        <% c.tags.forEach(function (t) { %><a class="tag" href="<%= c.base %>/?tag=<%= encodeURIComponent(t) %>">#<%= t %></a><% }) %>
      </p>
    </div>
  </li>
<% }) %>
</ul>
<% } %>
