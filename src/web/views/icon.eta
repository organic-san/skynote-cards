<%
/*
  單色圖示。24 的 viewBox、stroke 用 currentColor，所以永遠跟旁邊的字同色。

  ---- 一個被推翻的決定 ----
  先前七枚關係圖示共用「圓角方塊＝一張卡」這個語彙，想讓它們讀起來是一家人。
  這個決定被推翻，因為它們實際只有 16–20px：那個尺寸下看不到方塊裡的差別，
  七枚全部變成同一坨灰色方塊——為了「成套」而犧牲的正是圖示存在的理由。

  現在的準則相反：**七個輪廓要彼此不同**。
  一枚小圖示能傳遞的只有兩三筆與整體形狀，所以每一枚各佔一種形狀：

    節錄自  方括號框住一塊實心      唯一有填色的
    關聯自  一支箭指到一道邊         唯一「箭＋豎線」
    延伸自  兩個圓環相連            唯一的雙圓
    支撐自  一根橫梁架在兩根柱上     唯一的門型
    牴觸    上下兩支箭迎面          唯一的雙列
    反駁    一個叉                  唯一的斜十字
    更新自  兩層向上的人字          唯一的疊人字

  一條 rel 常常背著好幾個名字（`updates` 是「更新」也是「完整化」，
  `supports` 是「引證」也是「進一步論述」），所以圖示畫的必須是**關係本身**，
  不是其中某一個名字。「完整化」是把碎片抬成主張，「更新」是換上更好的版本——
  共同的動作是**往上一階**，所以是向上的人字，不是迴轉箭頭：
  迴轉箭頭讀起來是「重新整理」，那是另一件事。

  成套感改由尺寸、筆觸與留白維持，不由形狀維持。
*/
const paths = {
  // ---- 去處與動作
  home: '<path d="M3.4 10.6 12 3.5l8.6 7.1"/><path d="M5.6 9.3V19a1.5 1.5 0 0 0 1.5 1.5h9.8a1.5 1.5 0 0 0 1.5-1.5V9.3"/>',
  // 追加外部資料。先前刻意避開 ＋（理由是右下浮動鈕已經是那個符號），
  // 這個決定被推翻——＋ 是「新增」最不需要學習的符號，而兩者的位置差得夠遠。
  plus: '<path d="M12 4.5v15M4.5 12h15"/>',
  tag: '<path d="M11.9 3.5H5.2a1.7 1.7 0 0 0-1.7 1.7v6.7c0 .45.18.88.5 1.2l7.5 7.5a1.7 1.7 0 0 0 2.4 0l6.7-6.7a1.7 1.7 0 0 0 0-2.4l-7.5-7.5a1.7 1.7 0 0 0-1.2-.5z"/><circle cx="8" cy="8" r="1.3"/>',
  search: '<circle cx="10.6" cy="10.6" r="6.6"/><path d="m15.4 15.4 5.1 5.1"/>',
  // 展開：兩支箭指向對角。唯一的雙對角，跟其他九枚都不撞。
  expand: '<path d="M14.2 4.5h5.3v5.3"/><path d="m19.5 4.5-5.8 5.8"/><path d="M9.8 19.5H4.5v-5.3"/><path d="m4.5 19.5 5.8-5.8"/>',

  // ---- 七種關係。每一枚一種輪廓，見上面的表。
  // 節錄自：方括號框住的那一塊，就是從整份材料裡取出來的部分。
  // 括號在兩側才讀得出「這一段，出自更大的東西」；只有單邊時像兩個無關的記號。
  'part-of': '<path d="M7.5 3.5H4v17h3.5"/><path d="M16.5 3.5H20v17h-3.5"/><rect x="9" y="9.2" width="6" height="5.6" rx="1.2" fill="currentColor" stroke="none"/>',
  // 關聯自：一支箭指到那一份的邊上。有終點才是「指向某物」，
  // 光一支箭在任何介面裡都可以是任何意思。
  about: '<path d="M3.5 12h11.5"/><path d="m10.8 7.8 4.2 4.2-4.2 4.2"/><path d="M19.5 4.5v15"/>',
  // 延伸自：兩個圓環相連，線上沒有箭頭——關係還沒定型，不給方向。
  related: '<circle cx="5.8" cy="12" r="3.3"/><circle cx="18.2" cy="12" r="3.3"/><path d="M9.1 12h5.8"/>',
  // 支撐自：一根橫梁架在兩根柱上。支撐就是這個形狀——底下那些東西撐著上面。
  supports: '<path d="M3.2 8.5h17.6"/><path d="M7.5 8.5v11.8M16.5 8.5v11.8"/>',
  // 牴觸：上下兩支箭迎面而來、停在中間。唯一的雙列。
  contradicts: '<path d="M3 8h9"/><path d="m8.6 4.6 3.4 3.4-3.4 3.4"/><path d="M21 16h-9"/><path d="m15.4 12.6-3.4 3.4 3.4 3.4"/>',
  // 反駁：一個叉。唯一的斜十字，也是最無需學習的「不」。
  refutes: '<path d="M5.5 5.5 18.5 18.5"/><path d="M18.5 5.5 5.5 18.5"/>',
  // 更新自：兩層向上的人字。它同時要背「更新」與「完整化」——
  // 一個是換上更好的版本，一個是把碎片抬成主張，共同的動作是往上一階。
  // 先前用迴轉箭頭，那讀起來是「重新整理」，不是「換掉」。
  updates: '<path d="m5 13.2 7-7 7 7"/><path d="m5 19.5 7-7 7 7"/>',
};
const name = it.name;
const d = paths[name] || '';
%><svg class="icon icon-<%= name %>" viewBox="0 0 24 24" width="20" height="20" aria-hidden="true"
     fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round"><%~ d %></svg>
