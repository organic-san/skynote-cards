<%
/*
  單色圖示。24 的 viewBox、stroke 用 currentColor，保持與文字同色。
  七種關係圖示各自具備辨識度互異之輪廓，尺寸與留白維持成套感。
*/
const paths = {
  // 去處與動作
  home: '<path d="M3.4 10.6 12 3.5l8.6 7.1"/><path d="M5.6 9.3V19a1.5 1.5 0 0 0 1.5 1.5h9.8a1.5 1.5 0 0 0 1.5-1.5V9.3"/>',
  plus: '<path d="M12 4.5v15M4.5 12h15"/>',
  tag: '<path d="M11.9 3.5H5.2a1.7 1.7 0 0 0-1.7 1.7v6.7c0 .45.18.88.5 1.2l7.5 7.5a1.7 1.7 0 0 0 2.4 0l6.7-6.7a1.7 1.7 0 0 0 0-2.4l-7.5-7.5a1.7 1.7 0 0 0-1.2-.5z"/><circle cx="8" cy="8" r="1.3"/>',
  search: '<circle cx="10.6" cy="10.6" r="6.6"/><path d="m15.4 15.4 5.1 5.1"/>',
  expand: '<path d="M14.2 4.5h5.3v5.3"/><path d="m19.5 4.5-5.8 5.8"/><path d="M9.8 19.5H4.5v-5.3"/><path d="m4.5 19.5 5.8-5.8"/>',
  copy: '<rect x="9" y="9" width="11.5" height="11.5" rx="2"/><path d="M6.5 15H5A1.5 1.5 0 0 1 3.5 13.5V5A1.5 1.5 0 0 1 5 3.5h8.5A1.5 1.5 0 0 1 15 5v1.5"/>',
  check: '<path d="m4.5 12.5 5 5 10-11"/>',
  lock: '<rect x="4.5" y="10.5" width="15" height="9.5" rx="2"/><path d="M8 10.5V7.5a4 4 0 0 1 8 0v3"/>',
  download: '<path d="M12 3.5v11"/><path d="m7.5 10 4.5 4.5 4.5-4.5"/><path d="M20 14.5v4a1.5 1.5 0 0 1-1.5 1.5h-13A1.5 1.5 0 0 1 4 18.5v-4"/>',
  refresh: '<path d="M20 12a8 8 0 1 1-2.34-5.66L20 8.5"/><path d="M20 4v4.5h-4.5"/>',
  pencil: '<path d="M15.6 4.6a2 2 0 0 1 2.8 0l1 1a2 2 0 0 1 0 2.8L8.6 19.2 4 20l.8-4.6z"/><path d="m13.8 6.4 3.8 3.8"/>',
  gear: '<path d="M10.19 5.24 10.66 2.49A9.6 9.6 0 0 1 13.34 2.49L13.81 5.24A7 7 0 0 1 15.5 5.94L17.78 4.33A9.6 9.6 0 0 1 19.67 6.22L18.06 8.5A7 7 0 0 1 18.76 10.19L21.51 10.66A9.6 9.6 0 0 1 21.51 13.34L18.76 13.81A7 7 0 0 1 18.06 15.5L19.67 17.78A9.6 9.6 0 0 1 17.78 19.67L15.5 18.06A7 7 0 0 1 13.81 18.76L13.34 21.51A9.6 9.6 0 0 1 10.66 21.51L10.19 18.76A7 7 0 0 1 8.5 18.06L6.22 19.67A9.6 9.6 0 0 1 4.33 17.78L5.94 15.5A7 7 0 0 1 5.24 13.81L2.49 13.34A9.6 9.6 0 0 1 2.49 10.66L5.24 10.19A7 7 0 0 1 5.94 8.5L4.33 6.22A9.6 9.6 0 0 1 6.22 4.33L8.5 5.94A7 7 0 0 1 10.19 5.24z"/><circle cx="12" cy="12" r="2.8"/>',
  // 已隱藏（篩選列，v3.2 §2.3）：被更新或反駁的卡收在這裡。跟 refutes 同形，但說的是「不列出」。
  // 叉連同圓角端點佔 viewBox 的 11.75 / 24，在 16px 的框裡約 8px，跟色點（--dot）一樣大。
  x: '<path d="M7 7 17 17"/><path d="M17 7 7 17"/>',
  // 拖曳的把手：六個點，跟「可以抓起來」的慣例一致。
