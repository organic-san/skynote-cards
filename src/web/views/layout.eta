<!doctype html>
<html lang="zh-Hant">
<head>
<meta charset="utf-8">
<%/* 只在有 JS 時才畫需要 JS 的控制項（見 card.css 的 html:not(.js)）。
     放在 head 而且是行內的，否則按鈕會先畫出來再消失。 */%>
<script>document.documentElement.classList.add('js')</script>
<meta name="viewport" content="width=device-width, initial-scale=1">
<title><%= it.title %> | Skynote</title>
<link rel="icon" href="/static/favicon.ico" sizes="any">
<%/* 網路字型只給觸控裝置（手機）。連不上時頁面照常可讀，只是換成系統字體。
     電腦上不載：Noto Sans TC 切成十幾個字檔，每換一頁都要在畫第一格之前重新解碼，
     包在 Ferdium 裡那段空檔就是一閃。Windows 11 本身裝著 Noto Sans TC（可變字重），
     tokens.css 的字體堆疊排在第一個，看起來一樣。media 對不上的樣式表不擋繪製。 */%>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link rel="stylesheet" media="(pointer: coarse)"
      href="https://fonts.googleapis.com/css2?family=Noto+Sans+TC:wght@400;500;600&display=swap">
<%/* 樣式依職責分檔，順序由 tokens.css 裡的 @layer 宣告保證，不靠這裡的先後。
     沒有打包步驟——改完存檔就生效，這是單人開發時很值錢的性質。
     內容直接嵌進每一頁，不另外請求：正式環境的 IAP 讓每個 CSS 請求都得回伺服器
     驗證，包在 Ferdium 這類 webview 裡，那一來一回就是換頁時的一閃（web/assets.ts）。 */%>
<style><%~ it.inlineCss('/static/css/tokens.css') %></style>
<style><%~ it.inlineCss('/static/css/base.css') %></style>
<style><%~ it.inlineCss('/static/css/shell.css') %></style>
<style><%~ it.inlineCss('/static/css/list.css') %></style>
<style><%~ it.inlineCss('/static/css/card.css') %></style>
<style><%~ it.inlineCss('/static/css/form.css') %></style>
<%/* 換頁不換文件（nav.js）：Ferdium 的 webview 裡，只要換文件就有一段露出底色的空檔。
     放在 head：defer 腳本照文件順序執行，它得比 body 裡每一支都早，才記得到它們掛的監聽。
     body 裡的腳本換頁時會重新跑一次，所以只能放在 body；head 裡的不會。 */%>
<script src="<%= it.asset('/static/js/nav.js') %>" defer></script>
</head>
<body>

<button class="menubtn" id="menubtn" aria-label="選單" aria-expanded="false">
  <span></span><span></span><span></span>
</button>
<div class="scrim" id="scrim" hidden></div>

<aside class="drawer" id="drawer">
  <button class="drawerclose" id="drawerclose" aria-label="關閉">×</button>

  <%/* 站名是標題，不是連結——回首頁那件事由下面第一列負責，
       因為手會先落在那裡。 */%>
  <p class="drawerbrand">Skynote</p>

  <%
    /* 側欄的每一項都指向目前所在的環境（v3.1）：base 是它的網址前綴，
       沒有環境時是空字串，網址跟以前一樣。 */
    const base = it.base || '';
    const envs = it.envs || [];
  %>
  <nav class="drawerwork">
    <a href="<%= base %>/" class="<%= it.nav === 'feed' ? 'on' : '' %>">
      <%~ include('icon', { name: 'home' }) %><span>首頁</span>
    </a>
  </nav>

  <%/* v3.1：環境。原本四份工作清單（待思考、初步想法、雜筆、沉澱）的位置——
       實際用到的只剩沉澱，而環境決定了這一欄其他每一項指的是哪裡。
       清單只拿來切換；新增、排序、改名都在標題右邊的齒輪打開的面板裡（</aside> 後面）。
       （無環境）是過渡的狀態，搬空了就不列。 */%>
  <nav class="drawernav drawerenvs" aria-label="環境">
    <div class="envhead">
      <p class="indexhead">環境</p>
      <button type="button" class="envgear" popovertarget="envpanel" aria-label="管理環境"
              title="新增、排序、改名"><%~ include('icon', { name: 'gear' }) %></button>
    </div>
    <% envs.forEach(function (e) { %>
    <a href="<%= e.href %>" data-env="<%= e.name %>" class="<%= e.on ? 'on' : '' %><%= e.name === '' ? ' envroot' : '' %>"><span
      class="indextitle"><%= e.label %></span></a>
    <% }) %>
  </nav>

  <%/* U10：「追加外部資料」與旁邊幾項同格式。
       先前刻意做成不一致（理由是它是動作、另兩個是去處），那個決定被撤回——
       實測壓力偏重，而且它已經在分隔線下方的動作與工具區，
       位置本身足以表達它不是去處。
       產出沒有側欄入口：沒有來處的產出從隨手記「展開」建立（v3 §4.3）。 */%>
  <nav class="drawernav">
    <a href="<%= base %>/new?type=original" class="<%= it.nav === 'source' ? 'on' : '' %>">
      <%~ include('icon', { name: 'plus' }) %><span>追加外部資料</span>
    </a>
    <a href="<%= base %>/search" class="<%= it.nav === 'search' ? 'on' : '' %>">
      <%~ include('icon', { name: 'search' }) %><span>搜尋</span>
    </a>
    <a href="<%= base %>/tags" class="<%= it.nav === 'tags' ? 'on' : '' %>">
      <%~ include('icon', { name: 'tag' }) %><span>標籤</span>
    </a>
    <%/* v3 §7：取回語料庫的最新版本。它有副作用，所以是一顆 POST 的按鈕，
         不是連結；外觀跟旁邊的去處一樣。取回的是整個語料庫，不分環境；
         帶著目前的環境只是為了讓結果頁留在這裡。 */%>
    <form method="post" action="/update">
      <input type="hidden" name="env" value="<%= it.env || '' %>">
      <button type="submit" class="<%= it.nav === 'update' ? 'on' : '' %>">
        <%~ include('icon', { name: 'refresh' }) %><span>更新</span>
      </button>
    </form>
  </nav>

  <%/* v3 §5：側欄下半跟著頁面換。
       文章一覽（首頁、搜尋、標籤頁）列最近的標籤：在一覽裡找方向時，主題是入口。
       卡片頁與編輯介面（編輯頁、建立表單）列最近的卡片：寫連結要指向誰，
       看一眼名字就知道。兩份都只列名稱、不列數量——這一欄要安靜。
       兩份都以目前的環境為界。 */%>
  <% const recent = it.recent || []; const sidetags = it.sidetags || []; %>
  <% if (recent.length) { %>
  <div class="sidecards">
    <p class="indexhead">最近的卡片</p>
    <ul>
      <% recent.forEach(function (c) { %>
      <%/* 色點而不是型別名：這一欄很窄，標題本來就在截斷邊緣，再塞兩個字進去
           等於把標題再砍掉兩個字。U1 說顏色不得單獨承擔型別資訊——
           在這裡它沒有單獨承擔，點進去就看得到型別名。 */%>
      <li><a href="/c/<%= c.id %>" class="<%= it.activeId === c.id ? 'on' : '' %>"><span
        class="dot dot-<%= c.type %>"></span><span class="indextitle"><%= c.title %></span></a></li>
      <% }) %>
    </ul>
  </div>
  <% } else if (sidetags.length) { %>
  <div class="sidetags">
    <p class="indexhead">最近的標籤</p>
    <ul>
      <% sidetags.forEach(function (t) { %>
      <li><a href="<%= base %>/?tag=<%= encodeURIComponent(t) %>" class="<%= it.tag === t ? 'on' : '' %>"><span
        class="indextitle">#<%= t %></span></a></li>
      <% }) %>
    </ul>
  </div>
  <% } %>
</aside>

<%/* 環境面板：側欄「環境」右邊的齒輪打開。用瀏覽器內建的 popover——不用 JS 就打得開，
     Esc 或點外面就關。放在側欄外面：窄螢幕上側欄收起來時，它不該跟著不見。
     新增與改名是一般的表單，沒有 JS 也能用；拖曳排序要 JS（envs.js），沒有 JS 時把手不畫。
     每個環境都能改名：每一列都標著名字，不會改錯。
     （無環境）不在這裡：它不能改名，也不參與排序。 */%>
<% const named = envs.filter(function (e) { return e.name !== ''; }); %>
<div class="envpanel" id="envpanel" popover role="dialog" aria-labelledby="envpaneltitle">
  <div class="envpanelhead">
    <h2 id="envpaneltitle">環境</h2>
    <button type="button" class="textbtn" popovertarget="envpanel" popovertargetaction="hide"
            aria-label="關閉">×</button>
  </div>
  <% if (named.length) { %>
  <ol class="envsort" id="envsort">
    <% named.forEach(function (e) { %>
    <li class="envitem" data-env="<%= e.name %>">
      <button type="button" class="envgrip" aria-label="移動「<%= e.name %>」：拖曳，或按上下鍵"><%~
        include('icon', { name: 'grip' }) %></button>
      <span class="envname"><%= e.name %></span>
      <details class="envedit">
        <summary aria-label="改名「<%= e.name %>」" title="改名"><%~ include('icon', { name: 'pencil' }) %></summary>
        <form method="post" action="/envs/rename" class="envform">
          <input type="hidden" name="from" value="<%= e.name %>">
          <input type="hidden" name="at" value="<%= it.env || '' %>">
          <input type="text" name="name" value="<%= e.name %>" required maxlength="40"
                 autocomplete="off" spellcheck="false" aria-label="新的名稱">
          <button type="submit" class="textbtn">改名</button>
        </form>
      </details>
    </li>
    <% }) %>
  </ol>
  <% } %>
  <form method="post" action="/envs" class="envform envnew">
    <input type="hidden" name="from" value="<%= it.env || '' %>">
    <input type="text" name="name" required maxlength="40" autocomplete="off" spellcheck="false"
           placeholder="新的環境名稱" aria-label="新的環境名稱">
    <button type="submit" class="textbtn">建立</button>
  </form>
  <p class="envnote" id="envnote" role="status"></p>
</div>

<main>
<%~ it.body %>
</main>

<% if (it.fab) { %>
<button class="fab" id="fab" aria-label="新增" aria-expanded="false">＋</button>

<% if (it.fab.actions) { %>
<%/* 卡片頁：選單裡有哪些按鈕由這張卡的型別決定，每一顆都預填好
      新卡的型別與那條連結，不需要知道規則存在。 */%>
<div class="fabmenu" id="fabmenu" hidden>
  <%/* 順序由 CARD_ACTIONS 排定，不在這裡分組。 */%>
  <% it.fab.actions.forEach(function (a) { %>
  <a class="fabmenu-item" href="<%= a.href %>">
    <%~ include('icon', { name: a.rel }) %><span><%= a.label %></span>
  </a>
  <% }) %>
</div>
<% } else { %>
<%/* 其他地方：隨手記。一個文字框加一個送出鍵，只寫碎片（v3 §4.3）。
      要記成思考或產出就按「展開」，在完整表單上選：思考需要標籤（R11），
      標籤欄在那裡。寫進目前所在的環境（v3.1）。 */%>
<%
  /* 槽名由伺服器算好（見 routes 的 shell）：帶著環境與 ?tag= 篩選，
     切換環境或標籤等於換一張表單，兩份草稿不該互相覆蓋。 */
  const quickScope = it.quickScope || 'quick';
%>
<div class="quick" id="fabmenu" hidden>
  <%/* 「展開」跟「隨手記」同一排，右對齊。它不是送出的替代方案，是
       「這一則不是一句話講得完的」——那是在你開始寫之前或寫到一半就會知道的事，
       所以它該在標題那一排看得到，而不是躲在動作列裡跟送出鍵競爭。

       用 form= 掛回底下那張表單，所以它人在表單外面，送出的仍是同一份內容。 */%>
  <%/* 展開按鈕掛回底下的隨手記表單送出（form=quickform）。 */%>
  <p class="quickhead">
    <%/* 篩選生效時說出記的是哪一堆。標籤在「展開」之後可以自由改動，
         不鎖定——篩選只是你此刻在看哪一堆，不是對這張新卡的承諾。 */%>
    <span>隨手記<% if (it.tag) { %> · #<%= it.tag %><% } %></span>
    <button type="submit" class="textbtn quickexpand" form="quickform"
            name="expand" value="1" formnovalidate>
      <span>展開</span><%~ include('icon', { name: 'expand' }) %>
    </button>
  </p>
  <form method="post" action="<%= base %>/quick" id="quickform" data-draft-scope="<%= quickScope %>">
    <%/* 槽名跟著送出去，伺服器原樣掛回導向的 ?d=——建立成功才清除，
         驗證失敗那條路不會經過導向，草稿因此自動留著。 */%>
    <input type="hidden" name="draft_scope" value="<%= quickScope %>">
    <% if (it.tag) { %><input type="hidden" name="tags" value="<%= it.tag %>"><% } %>
    <textarea name="body" rows="5" spellcheck="false" placeholder="現在想到什麼" autofocus></textarea>
    <%/* U18（「將存為什麼」）撤回：只會存成碎片，沒有要顯示的判斷。 */%>
    <button type="submit" class="primary" id="quicksubmit">記為碎片</button>
  </form>
</div>
<% } %>
<% } %>

<script src="<%= it.asset('/static/js/app.js') %>" defer></script>
<script src="<%= it.asset('/static/js/envs.js') %>" defer></script>
<%/* 草稿暫存掛在最後：它要對已經由 typefields.js 開關過的欄位取快照，
     順序錯了會把關掉的欄位一起存進去。 */%>
<script src="<%= it.asset('/static/js/draft.js') %>" defer></script>
</body>
</html>
