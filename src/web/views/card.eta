<% if (it.from) { %>
<p class="fromsource">已從 <a href="/c/<%= it.from.id %>"><%= it.from.title %></a> 建立</p>
<% } else { %>
<p class="back"><a href="/">← 返回</a></p>
<% } %>

<%/* U12：卡片內容在前，關聯區塊在後。
     先前把關聯樹放在標題之上，一進頁面先讀到後設資料，而且標題的垂直位置
     隨連結多寡浮動，頁面沒有固定落點。 */%>
<article class="card">
  <h1><%= it.card.title %></h1>
  <p class="cardmeta">
    <span class="dot dot-<%= it.card.type %>"></span>
    <span class="tname"><%= it.type_label %></span>
    <span class="sep">·</span>
    <time datetime="<%= it.created_display.iso %>"><%= it.created_display.text %></time>
    <% if (it.revised_display) { %>
    <span class="sep">·</span><span>改於 <time datetime="<%= it.revised_display.iso %>"><%= it.revised_display.text %></time></span>
    <% } %>
    <% if (it.provenance) { %><span class="sep">·</span><span><%= it.provenance %></span><% } %>
    <%/* 反芻期上線後在同一行末尾追加第三段（可修改 N 小時／已定案），
         不加框、不做倒數跳動。位置先留著（U12）。 */%>
  </p>

  <% if (it.card.tags.length) { %>
  <p class="tags">
    <% it.card.tags.forEach(function (t) { %><a class="tag" href="/?tag=<%= encodeURIComponent(t) %>">#<%= t %></a><% }) %>
  </p>
  <% } %>

  <% if (it.url_href) { %>
  <div class="source">
    <% if (it.embed && it.embed.kind === 'image') { %>
    <a href="<%= it.url_href %>" rel="noreferrer noopener">
      <img class="embed" src="<%= it.embed.src %>" alt="" loading="lazy" referrerpolicy="no-referrer">
    </a>
    <% } else if (it.embed) { %>
    <div class="embed embed-<%= it.embed.kind %>">
      <iframe src="<%= it.embed.src %>" loading="lazy" referrerpolicy="no-referrer"
              allow="fullscreen; picture-in-picture" title="<%= it.card.title %>"></iframe>
    </div>
    <% } %>
    <p class="sourcelink"><a href="<%= it.url_href %>" rel="noreferrer noopener"><%= it.card.url %></a></p>
  </div>
  <% } %>

  <div class="body"><%~ it.body_html %></div>

  <% if (it.editable) { %>
  <p class="actions"><a href="/c/<%= it.card.id %>/edit">編輯</a></p>
  <% } %>
</article>

<%/* U13：關聯區塊維持縱向的體感式結構。上游在上、下游在下，
     中間是「你在這裡」，方向由**空間位置**表達而不是由文字說明表達。
     卡片本身沒有任何連結時兩側不留空欄，只顯示「你在這裡」一行。 */%>
<section class="links">
  <% if (it.upstream.length) { %>
  <div class="stream up">
    <%~ include('thread', { nodes: it.upstream }) %>
    <p class="streamcount">↑ <%= it.upstream_count %></p>
  </div>
  <% } %>

  <p class="youarehere">你在這裡：<span><%= it.card.title %></span></p>

  <% if (it.downstream.length) { %>
  <div class="stream down">
    <p class="streamcount">↓ <%= it.downstream_count %></p>
    <%~ include('thread', { nodes: it.downstream }) %>
  </div>
  <% } %>
</section>
